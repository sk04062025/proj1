# Start with your base Logstash image
FROM docker.elastic.co/logstash/logstash:8.11.0

# 1. (Optional but recommended) Install ca-certificates and openssl in case they are missing
#    Logstash images are usually fairly lean.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    openssl \
    && rm -rf /var/lib/apt/lists/*

# 2. Copy your company's CA certificates into the container
#    Place your .crt files in the same directory as your Dockerfile or adjust the path.
COPY company_root.crt /usr/local/share/ca-certificates/company_root.crt
COPY company_intermediate.crt /usr/local/share/ca-certificates/company_intermediate.crt

# 3. Update the system's CA trust store
RUN update-ca-certificates

# --- FIX: Specify the full path to keytool and cacerts ---

# 4. Define the full path to keytool and the cacerts file
ENV LOGSTASH_JDK_HOME /usr/share/logstash/jdk
ENV JAVA_CACERTS $LOGSTASH_JDK_HOME/lib/security/cacerts
ENV KEYTOOL_PATH $LOGSTASH_JDK_HOME/bin/keytool

# Import root certificate
RUN $KEYTOOL_PATH -import -trustcacerts -keystore $JAVA_CACERTS -storepass changeit \
    -file /usr/local/share/ca-certificates/company_root.crt -alias companyroot -noprompt

# Import intermediate certificate
RUN $KEYTOOL_PATH -import -trustcacerts -keystore $JAVA_CACERTS -storepass changeit \
    -file /usr/local/share/ca-certificates/company_intermediate.crt -alias companyintermediate -noprompt

# 5. Now try to install the plugin
RUN /usr/share/logstash/bin/logstash-plugin install logstash-input-jdbc
